---
// src/components/CreateSection.astro

const cards = [
  {
    icon: "☁",
    title: "Cloud Services",
    desc: "Run performant services on Linux and deploy to the cloud.",
    href: "https://www.swift.org/get-started/cloud-services",
  },
  {
    icon: "⌨",
    title: "Command Line",
    desc: "Create powerful CLI tools that are fast and memory safe.",
    href: "https://www.swift.org/get-started/command-line-tools",
  },
  {
    icon: "⚡",
    title: "Embedded",
    desc: "Develop efficient, reliable firmware for devices like microcontrollers.",
    href: "https://www.swift.org/get-started/embedded",
  },
];

const tags = [
  { label: "iOS apps", href: "https://www.swift.org/getting-started/swiftui/" },
  { label: "Windows apps", href: "https://www.swift.org/blog/swift-everywhere-windows-interop/" },
  { label: "Machine Learning & AI", href: "https://www.swift.org/blog/mlx-swift/" },
  { label: "Packages", href: "https://www.swift.org/getting-started/library-swiftpm/" },
];
---

<section class="create-section">
  <h2>Create using Swift</h2>

  <div class="create-cards">
    {cards.map((c) => (
      <a class="create-card" href={c.href}>
        <span class="card-icon" aria-hidden="true">{c.icon}</span>
        <h3>{c.title}</h3>
        <p>{c.desc}</p>
      </a>
    ))}
  </div>

  <div class="create-tags">
    {tags.map((t) => (
      <a class="tag" href={t.href}>{t.label}</a>
    ))}
  </div>
</section>

<style>
  .create-section {
    padding: 3.5rem 2rem;
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
  }

  .create-section h2 {
    font-size: 13px;
    font-weight: 500;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 1.75rem;
  }

  .create-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .create-card {
    background: #f5f5f7;
    border: 0.5px solid #e0e0e0;
    border-radius: 12px;
    padding: 1.5rem 1.25rem;
    text-align: left;
    transition: background 0.15s, box-shadow 0.15s;
    display: block;
  }

  .create-card:hover {
    background: #ebebed;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .card-icon {
    font-size: 22px;
    display: block;
    margin-bottom: 0.6rem;
  }

  .create-card h3 {
    font-size: 15px;
    font-weight: 500;
    color: #1a1a1a;
    margin-bottom: 0.4rem;
  }

  .create-card p {
    font-size: 13px;
    color: #555;
    line-height: 1.5;
  }

  .create-tags {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .tag {
    background: #f5f5f7;
    border: 0.5px solid #e0e0e0;
    border-radius: 20px;
    padding: 6px 16px;
    font-size: 13px;
    color: #555;
    transition: background 0.15s, color 0.15s;
  }

  .tag:hover {
    background: #FA7343;
    color: #fff;
    border-color: #FA7343;
  }

  @media (max-width: 640px) {
    .create-cards { grid-template-columns: 1fr; }
  }
</style>
